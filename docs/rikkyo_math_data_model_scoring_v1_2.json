  "scoringEngine": {
    "version": "math-grader-v1",
    "parser": {
      "policy": "whitelist grammar only; never eval",
      "maxInputLength": 500,
      "maxAstNodes": 200,
      "maxNumericMagnitude": "implementation-limited",
      "allowedSymbols": [
        "0-9",
        "x",
        "y",
        "a",
        "b",
        "m",
        "n",
        "r",
        "pi",
        "sqrt",
        "+",
        "-",
        "*",
        "/",
        "^",
        "(",
        ")",
        "=",
        ",",
        "<",
        ">",
        "≤",
        "≥",
        "±"
      ]
    },
    "normalization": {
      "whitespace": "ignore",
      "unicode": "normalize minus, multiplication signs, π, √, ≤, ≥",
      "fractions": "reduce for comparison",
      "decimals": "convert to exact rational when finite unless tolerance specified",
      "expressions": "safe parse and symbolic canonicalization",
      "solutionSets": "order-independent where answerSpec says so",
      "ratios": "reduce by common nonzero factor",
      "coordinates": "ordered pair order is significant",
      "intervals": "normalize equivalent inequality/interval forms without changing endpoint inclusion"
    },
    "answerKindRules": {
      "integer_numeric": "exact unless tolerance explicitly configured",
      "rational": "equivalent reduced fractions accepted; decimal acceptance follows answerSpec",
      "radical_expression": "symbolic equivalence accepted; no floating-only comparison for exact answers",
      "pi_expression": "π kept symbolic",
      "expression": "mathematical equivalence allowed only when answerSpec.equivalenceAllowed=true",
      "factorized_expression": "mathematical equivalence plus required factorized form",
      "expanded_expression": "mathematical equivalence plus required expanded form",
      "equation": "equivalent equations accepted, with required variable/form constraints",
      "solution_set": "compare sets and multiplicity only when mathematically relevant",
      "multi_response": "grade each slot independently; overall correctness follows all required slots",
      "probability": "exact rational comparison; enforce 0≤p≤1",
      "angle": "numeric exactness + semantic degree unit",
      "ratio": "scale-equivalent ordered ratios accepted",
      "coordinate": "ordered coordinates; domain constraints checked",
      "coordinate_set": "set of ordered coordinates, outer order-independent if configured",
      "interval": "endpoint/open-closed semantics preserved",
      "parameter_value": "Treat as a typed scalar/parameter assignment; equivalent scalar form accepted according to answerSpec.",
      "ratio_value": "Treat as an exact rational ratio value; equivalent rational forms accepted according to answerSpec."
    },
    "unitPolicy": {
      "default": "Do not invent a required unit when the source does not state one.",
      "officialScore": "Require a unit only when official/source rule confirms it.",
      "learningScore": "May warn about missing expected unit without converting it into official-point loss when official rule is unknown."
    },
    "partialCredit": {
      "official": "No guessed official partial credit. Use only official ScoreSpec when available.",
      "learning": "Slot-level / step-level learning score permitted for multi-response and error-carried-forward learning feedback.",
      "errorCarriedForward": "Never add to OfficialScore unless official rules support it."
    },
    "ambiguityHandling": {
      "rule": "If answerSpec is internally ambiguous, deterministic grading returns REVIEW_REQUIRED and the item is excluded from exact accuracy/mastery until an explicit project convention resolves it.",
      "knownCurrentCase": "R26-MATH-A-Q5-3"
    }
  },
  "versionCompatibility": {
    "attemptRule": "Attempt stores the versions actually seen/used.",
    "minorContentFix": "Keep question ID, increment contentVersion.",
    "gradingOnlyFix": "Keep question ID/content; increment answerSpecVersion or scoreSpecVersion.",
    "majorContentFix": "Mark requiresReevaluation and define compatibility before using old attempts in current mastery.",
    "retiredQuestion": "Never delete/reuse ID; keep historical attempts resolvable."
  },
  "migrationAndStorage": {
    "currentStorageSchemaVersion": 1,
    "migrationRule": "Every schemaVersion change has forward migration and rollback-safe pre-migration backup.",
    "importValidation": [
      "schemaVersion present",
      "required top-level keys present",
      "attemptId unique",
      "problemId references valid or retained as historical/retired references",
      "checksum verified when present",
      "import cannot overwrite current data before automatic backup"
    ],
    "syncRule": "Merge attempts by attemptId; do not add snapshots blindly. Recompute derived SkillState after merge.",
    "namespaceRule": "production/test/qa separated so QA attempts never contaminate learner history.",
    "legacyNamespaceMigration": {
      "from": "rikkyoMathMvp:<namespace>:v1",
      "to": "rikkyoMathMvp:<namespace>:v2",
      "rule": "Loader must check the legacy key when the v2 key is absent, migrate forward, and preserve the old key until migration validation succeeds."
    }
  },
  "mvpScope": {
